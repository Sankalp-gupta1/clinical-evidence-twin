# Local use works without any external service.
# On Vercel, DATABASE_URL and SESSION_SECRET are required for writes.
# Provision these through your hosting provider, then pull them into .env.local.
# Never commit .env.local or print its contents.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# SESSION_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES

# Optional AI summaries. Keep false until a model and credentials are ready.
AI_ENABLED=false
# AI_MODEL=CHOOSE_A_CURRENT_SUPPORTED_MODEL_ID
# GOOGLE_API_KEY=USE_A_SECURE_PROVIDER_SECRET_FIELD
# Or use AI_GATEWAY_API_KEY; Vercel OIDC is also supported by the gateway adapter.

# Optional hosted MCP. Use a long random token and an explicitly scoped workspace.
# MCP_ACCESS_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
# MCP_WORKSPACE_ID=EXACT_WORKSPACE_UUID
# If MCP_WORKSPACE_ID is absent, tools expose only the original synthetic examples.
