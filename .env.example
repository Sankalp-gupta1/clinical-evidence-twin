# Public demo needs no credentials. Accounts and saved hospital reviews need:
# DATABASE_URL=USE_THE_PROVIDER_PROVISIONED_TLS_CONNECTION
# BETTER_AUTH_SECRET=GENERATE_32_OR_MORE_RANDOM_BYTES
# BETTER_AUTH_URL=http://localhost:3000
# Production URL: https://clinical-evidence-twin.vercel.app
# Put real values in the hosting secret fields / .env.local. Never commit them.

# Optional account verification and password reset emails.
# RESEND_API_KEY=USE_THE_SECURE_PROVIDER_SECRET_FIELD
# EMAIL_FROM=YOUR_VERIFIED_SENDER

# Optional model summaries. Public demo questions never call a model.
AI_ENABLED=false
# AI_MODEL=EXACT_SUPPORTED_PROVIDER_MODEL_ID
# GOOGLE_API_KEY=USE_THE_SECURE_PROVIDER_SECRET_FIELD
# AI_GATEWAY_API_KEY=USE_THE_SECURE_PROVIDER_SECRET_FIELD
# Valid Vercel OIDC is also supported by the gateway adapter.
AI_DAILY_REQUEST_LIMIT=100

# Optional read-only MCP integration.
# MCP_ACCESS_TOKEN=GENERATE_A_STRONG_RANDOM_TOKEN
# MCP_WORKSPACE_ID=EXACT_HOSPITAL_UUID
MCP_ALLOW_HOSPITAL_ACCESS=false
# Without both the explicit allow flag and workspace ID, hosted MCP reads seed data only.
